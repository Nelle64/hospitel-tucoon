{
  "name": "pixel-hospital",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel Hospital \u2013 a mobile-first hospital tycoon PWA",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "assets": "tsx tools/generate-assets/index.ts",
    "validate:data": "tsx tools/validate-data.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:campaign": "vitest run --project campaign",
    "test:stress": "tsx tools/sim/stress.ts",
    "balance": "tsx tools/sim/balance.ts",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "playwright test",
    "ci": "npm run assets && npm run validate:data && npm run typecheck && npm run lint && npm test && npm run test:campaign && npm run build && npm run e2e",
    "prebuild": "npm run assets",
    "predev": "npm run assets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
